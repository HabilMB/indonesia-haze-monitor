# Free key, emailed on signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your-firms-map-key
# GCP project (BigQuery sandbox, no billing account)
GCP_PROJECT_ID=your-gcp-project-id
# Loader service-account JSON key; keep it under secrets/ (gitignored) or outside the repo
GOOGLE_APPLICATION_CREDENTIALS=secrets/loader-sa.json
