# Free key, emailed on signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your-firms-map-key
# GCP project (BigQuery sandbox, no billing account)
GCP_PROJECT_ID=your-gcp-project-id
# Loader service-account JSON key; keep it under secrets/ (gitignored) or outside the repo
GOOGLE_APPLICATION_CREDENTIALS=secrets/loader-sa.json

# Local Airflow (docker compose) only
# Host user id, so the containers can read the 0600 key file: `id -u`
AIRFLOW_UID=1000
# Postgres metadata DB password (hex keeps the connection URL valid): `openssl rand -hex 16`
AIRFLOW_DB_PASSWORD=change-me
# Password for the `admin` login at http://127.0.0.1:8080
AIRFLOW_ADMIN_PASSWORD=change-me
# Signs tokens between Airflow components: `openssl rand -hex 32`
AIRFLOW_JWT_SECRET=change-me
